{
  "name": "revelen",
  "version": "0.6.0",
  "description": "Learn reverse engineering step by step, through MCP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test test/optimizer.test.mjs test/tutor.test.mjs test/web-unit.test.mjs && node test/smoke.mjs",
    "test:web": "npm run build && node --test --test-concurrency=1 test/web/browser.test.mjs",
    "prepublishOnly": "npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "revelen": "dist/index.js"
  },
  "files": [
    "dist",
    "labs/*.c"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedi56/Revelen.git"
  },
  "keywords": [
    "mcp",
    "reverse-engineering",
    "education",
    "ghidra"
  ],
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
